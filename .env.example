# ==========================================================================
# ai-gateway-provider — environment configuration
# ==========================================================================

# --------------------------------------------------------------------------
# Upstream Freebuff / Codebuff credentials
# --------------------------------------------------------------------------
# Comma-separated bearer tokens for the Codebuff/Freebuff account pool.
# Multiple tokens enable round-robin load balancing across accounts.
FREEBUFF_TOKEN=

# Base URL of the upstream API (defaults to https://www.codebuff.com)
CODEBUFF_BASE_URL=
FREEBUFF_API_BASE_URL=

# --------------------------------------------------------------------------
# Local gateway auth
# --------------------------------------------------------------------------
# Optional bearer key that clients must send as Authorization: Bearer <key>.
# Leave empty to disable local auth.
FREEBUFF_API_KEY=

# --------------------------------------------------------------------------
# Ads & streak
# --------------------------------------------------------------------------
FREEBUFF_AD_PROVIDERS=gravity,carbon

# --------------------------------------------------------------------------
# Proxy
# --------------------------------------------------------------------------
# Upstream requests are direct by default and never read system HTTP(S)_PROXY
# unless FREEBUFF_PROXY_ENABLED=true.
FREEBUFF_PROXY_ENABLED=false
FREEBUFF_PROXY_URL=

# --------------------------------------------------------------------------
# Logging
# --------------------------------------------------------------------------
FREEBUFF_DEBUG=false
FREEBUFF_LOG_LEVEL=INFO
FREEBUFF_LOG_BODY_CHARS=2000
FREEBUFF_LOG_COLOR=true

# --------------------------------------------------------------------------
# Server
# --------------------------------------------------------------------------
FREEBUFF_HOST=0.0.0.0
FREEBUFF_PORT=1221

# --------------------------------------------------------------------------
# Device fingerprint (ad targeting / waiting room)
# --------------------------------------------------------------------------
FREEBUFF_TIMEZONE=Asia/Shanghai
FREEBUFF_LOCALE=zh-CN
FREEBUFF_OS=windows

# --------------------------------------------------------------------------
# Chat history (per-project, recall "do you remember ...")  -- optional
# --------------------------------------------------------------------------
# FREEBUFF_HISTORY_DIR=data/chat_history
# FREEBUFF_HISTORY_MAX_AGE_DAYS=365
# FREEBUFF_HISTORY_INJECT_MODE=memory_only   # memory_only | always | off
# FREEBUFF_HISTORY_CONTEXT_MAX_CHARS=4000

# --------------------------------------------------------------------------
# Freebuff tokens: prefer the dashboard / config file
# --------------------------------------------------------------------------
# Tokens are stored in config/freebuff-tokens.json (gitignored) and can be
# configured from the dashboard (port 2222) — no .env editing needed. The file
# wins over FREEBUFF_TOKEN below when both exist.
# FREEBUFF_TOKENS_FILE=config/freebuff-tokens.json
